# --- Основное ---
APP_NAME=Drone Alert Radar
ENVIRONMENT=development
# PostgreSQL для Docker; локально можно sqlite+aiosqlite:///./radar.db
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUTO_CREATE_TABLES=true

# --- Окна событий (минуты) ---
ACTIVE_WINDOW_MINUTES=240
ALL_CLEAR_WINDOW_MINUTES=90
DEDUP_WINDOW_MINUTES=120
DEDUP_FUZZY_WINDOW_MINUTES=20
DEDUP_SIMILARITY_THRESHOLD=0.55

# --- Telegram (только публичные каналы) ---
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=
# Если не задано, используется файловая сессия data/radar.session
TELEGRAM_SESSION=data/radar
# TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNELS=
TELEGRAM_BACKFILL_LIMIT=20
# Прокси для выхода в Telegram (напрямую из РФ Telegram часто недоступен).
# Форматы: socks5://[user:pass@]host:port | http://host:port | mtproxy://secret@host:port
# TELEGRAM_PROXY=socks5://127.0.0.1:7891
# TELEGRAM_PROXY=mtproxy://secret@127.0.0.1:1443

# --- RSS ---
RSS_FEEDS=
RSS_POLL_SECONDS=90

# --- Уведомления ---
NOTIFY_ENABLED=true
NOTIFY_SCHEDULER_ENABLED=true
NOTIFY_POLL_SECONDS=20
NOTIFY_WINDOW_MINUTES=30
NOTIFY_ALL_CLEAR=true
# Пусто = все регионы; иначе коды через запятую: RU-BELGOROD,RU-KURSK
NOTIFY_REGIONS=
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_CHAT_ID=

# --- Приём из официальных API ---
# INGEST_TOKEN=change-me
